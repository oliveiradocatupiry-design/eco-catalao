{
  "expo": {
    "name": "EcoCatalão",
    "slug": "ecocatalao-mobile",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/ecocatalao-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.org.ecocatalao.mobile",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3EFE4",
        "foregroundImage": "./assets/images/ecocatalao-icon.png"
      },
      "package": "br.org.ecocatalao.mobile",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ecocatalao-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ecocatalao-icon.png",
          "backgroundColor": "#F6F7F2",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false,
          "recordAudioAndroid": false,
          "cameraPermission": "Permitir que o EcoCatalão fotografe um material para esta demonstração?"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o EcoCatalão mostre sua posição no mapa de pontos de coleta?"
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "Permitir selecionar uma foto do resíduo?"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d71552b9-24b0-45bd-be84-b3257a74f4bf"
      }
    }
  }
}
